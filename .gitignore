# Unreal Engine Gitignore
# https://github.com/github/gitignore/blob/main/UnrealEngine.gitignore

# Directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# VS Code and Visual Studio
.vscode/
.vs/
*.sln
*.suo
*.user
*.userosvs
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Xcode
Highly-build/
*.xcodeproj
*.xcworkspace

# OS files
.DS_Store
Thumbs.db

# Source Textures
*.TGA
*.tga

# Python cache
__pycache__/
*.pyc

# ROS / SIRV dependencies (binaries presentes em ambas as maquinas)
Plugins/Sirv/SirvDependencies/

*.bak

